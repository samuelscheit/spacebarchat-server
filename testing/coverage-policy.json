        },
        {
            "id": "api-oauth-connections",
            "type": "http-route",
            "service": "api",
            "pathPrefix": "/oauth2",
            "testTier": "integration",
            "benchmarkClass": "route-class",
            "fixtureRequirements": ["users", "applications", "oauth-clients"],
            "contractChecks": ["auth-boundary", "schema-validation", "redirects", "token-state"]

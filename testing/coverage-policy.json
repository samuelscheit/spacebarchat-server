    "featureRules": [
        {
            "id": "gateway-opcodes",
            "type": "opcode",
            "service": "gateway",
            "testTier": "protocol-integration",
            "benchmarkClass": "protocol-load",
            "fixtureRequirements": ["users", "sessions", "guilds", "channels", "event-bus"],
            "contractChecks": ["hello", "identify", "heartbeat", "resume", "bad-payload-close", "event-fanout"]
        },
        {
            "id": "webrtc-opcodes",
            "type": "opcode",
            "service": "webrtc",
            "testTier": "protocol-integration",
            "benchmarkClass": "protocol-load",
            "fixtureRequirements": ["users", "sessions", "voice-states", "fake-media-server"],
            "contractChecks": ["identify", "select-protocol", "speaking", "video", "guard-size-rate"]
        }
    ],
    "manualFeatures": [
        {
            "id": "api:middleware:auth-rate-limit-error",
            "service": "api",
            "name": "Authentication, rate limiting, body parsing, translation, and error handling middleware",
            "sourceFile": "src/api/middlewares/index.ts",
            "testTier": "middleware-contract",
            "benchmarkClass": "micro",
            "fixtureRequirements": ["config", "users", "sessions"],
            "contractChecks": ["auth-boundary", "rate-limit-headers", "invalid-json", "localized-errors"]
        },
        {
            "id": "server:database:migrations-startup",
            "service": "server",
            "name": "Database initialization and migrations",
            "sourceFile": "src/util/util/Database.ts",
            "testTier": "migration-integration",
            "benchmarkClass": "startup-health",
            "fixtureRequirements": ["postgres"],
            "contractChecks": ["fresh-boot", "full-chain", "idempotent-rerun", "apply-migrations-toggle"]
        },
        {
            "id": "server:event-bus",
            "service": "server",
            "name": "Event dispatch transports and subscriptions",
            "sourceFile": "src/util/util/Event.ts",
            "testTier": "integration",
            "benchmarkClass": "micro",
            "fixtureRequirements": ["event-bus", "rabbitmq-mock"],
            "contractChecks": ["emit-listen", "acknowledge", "reconnect", "subscription-filter"]
        },
        {
            "id": "benchmarks:harness",
            "service": "benchmarks",
            "name": "Benchmark runner, suite metadata, profiler, and comparison output",
            "sourceFile": "scripts/benchmarks/run.js",
            "testTier": "tooling-contract",
            "benchmarkClass": "none",
            "fixtureRequirements": ["benchmark-fixtures"],
            "contractChecks": ["suite-validation", "summary-schema", "comparison-thresholds", "profile-artifacts"]
        }
    ]
}

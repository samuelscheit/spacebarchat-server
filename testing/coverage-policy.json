{
    "routeRules": [
        {
            "id": "api-app-bootstrap",
            "type": "http-route",
            "service": "api",
            "sourceFile": "src/api/Server.ts",
            "testTier": "app-smoke",
            "benchmarkClass": "startup-health",
            "fixtureRequirements": ["config"],
            "contractChecks": ["status", "headers", "body-shape"],
            "allowMissingRouteMetadata": true,
            "notes": "Root, well-known, image proxy, health, and static asset routes are registered outside src/api/routes."
        },
        {
            "id": "api-health-kubernetes",
            "type": "http-route",
            "service": "api",
            "pathPrefix": "/-/",
            "testTier": "app-smoke",
            "benchmarkClass": "startup-health",
            "fixtureRequirements": ["config"],
            "contractChecks": ["public-auth-boundary", "status"]
        },
        {
            "id": "api-auth",
            "type": "http-route",
            "service": "api",
            "pathPrefix": "/auth",
